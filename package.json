{
  "name": "piccoli-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed/seed.js",
     "test": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage"
  },
"jest": {
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "setupFilesAfterEnv": ["<rootDir>/tests/jest.setup.js"]
},
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "mongoose",
    "ecommerce",
    "api",
    "backend",
    "rest",
    "jwt",
    "zod"
  ],
  "author": "Luca Ramos",
  "license": "MIT",
  "description": "REST API for an e-commerce platform built with Node.js, Express and MongoDB. Includes authentication, product management and order lifecycle.",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2"
  }
}
